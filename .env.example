# Copy to .env and fill in. Never commit .env — see .gitignore.

# Set to 1 to run entirely offline against on-disk fixtures (see fixtures/, lib/demo-mode.*).
DEMO_MODE=0

# Where this app is deployed once `make deploy` has run — used by the keepalive workflow
# and by the Playwright demo recorder.
DEPLOY_URL=http://localhost:3000

# Postgres connection string (web2, web3). Default: a free Neon (https://neon.tech) database.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# OPTIONAL reference model (the "web model as evidence" audit). These three keys are read by
# `pnpm reference` ONLY. Nothing in the app, the demo path, `pnpm test`, or `pnpm claim:verify`
# reads them; with them unset the build, the tests and DEMO_MODE=1 all work unchanged and
# evidence/reference-labels.json is simply absent. The key is read from the environment, never
# written to a file, never logged, and never placed in a URL.
# Set REFERENCE_MODEL to any model id your provider serves; the endpoint must speak
# OpenAI-compatible /v1/chat/completions.
REFERENCE_API_KEY=
REFERENCE_BASE_URL=https://api.openai.com/v1
REFERENCE_MODEL=

# Chain read access (web3). An Alchemy or Infura HTTPS RPC URL for your target testnet — see
# docs/RPC.md. Empty means "use viem's own public default RPC" — fine for local dev, never
# for a real indexing run.
RPC_URL=
# The contract the indexer watches, and the block it was deployed at (indexing from 0 burns
# your RPC quota re-scanning empty history).
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
CHAIN_ID=11155111
# Shared secret the /api/cron/catchup route checks against Vercel's own cron invoker header.
CRON_SECRET=
